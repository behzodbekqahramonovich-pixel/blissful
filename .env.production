# Production Environment Variables
# Bu faylni serverda .env nomiga o'zgartiring va qiymatlarni to'ldiring

# Django Settings
SECRET_KEY=your-very-secret-key-here-generate-new-one
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip

# Database Settings
POSTGRES_DB=blissful_tour
POSTGRES_USER=blissful_user
POSTGRES_PASSWORD=your-secure-database-password-here

# Travelpayouts API (https://www.travelpayouts.com/)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
TRAVELPAYOUTS_MARKER=your_marker_id_here

# RapidAPI (https://rapidapi.com/)
RAPIDAPI_KEY=your_rapidapi_key_here

# Redis
REDIS_URL=redis://redis:6379/0

# Google Gemini AI (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
